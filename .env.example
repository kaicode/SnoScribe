# Optional: copy to ".env" and adjust. Compose also substitutes these when set in the shell.
# Remote FHIR terminology base (Snowstorm or other TX serving SNOMED CT $expand).
FHIR_TX_URL=https://implementation-demo.snomedtools.org/snowstorm-lite/fhir

# Ollama model tag (pull inside the ollama container after first start). For ~14GB RAM with Infinity + JVM, prefer smaller Gemma 4 variants.
LLM_OLLAMA_MODEL=gemma4:e2b

# Microsoft Foundry (host-run app only; set LLM_PROVIDER=azure and deploy Qwen/Gemma in Foundry first)
# LLM_PROVIDER=azure
# LLM_AZURE_BASE_URL=https://YOUR-ENDPOINT/v1
# AZURE_ML_API_KEY=
# LLM_AZURE_MODEL=Qwen/Qwen3.5-9B
